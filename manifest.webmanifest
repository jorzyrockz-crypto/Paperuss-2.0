{
  "id": "./",
  "name": "PapeRuss 2.0",
  "short_name": "PapeRuss 2.0",
  "description": "Offline-first notes, tasks, calendar, media, and planning workspace.",
  "start_url": "./app.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0b0e14",
  "theme_color": "#0b0e14",
  "categories": [
    "productivity",
    "utilities"
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "media",
          "accept": [
            "image/*",
            "text/*",
            "application/pdf"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "./app.html",
      "name": "Text/Markdown Documents",
      "icons": [
        {
          "src": "assets/icons/paperuss-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "accept": {
        "text/plain": [
          ".txt"
        ],
        "text/markdown": [
          ".md",
          ".markdown"
        ],
        "application/json": [
          ".json"
        ]
      }
    }
  ],
  "icons": [
    {
      "src": "assets/icons/paperuss-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icons/paperuss-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "New Note",
      "short_name": "New Note",
      "description": "Create a new note",
      "url": "./app.html?action=new-note",
      "icons": [{ "src": "assets/icons/paperuss-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "New Leaf",
      "short_name": "New Leaf",
      "description": "Add a new leaf tab",
      "url": "./app.html?action=new-leaf",
      "icons": [{ "src": "assets/icons/paperuss-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Bookmarks Branch",
      "short_name": "Bookmarks",
      "description": "Open Bookmarks branch",
      "url": "./app.html?action=bookmarks",
      "icons": [{ "src": "assets/icons/paperuss-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Quick Search",
      "short_name": "Search",
      "description": "Search notes and leaves",
      "url": "./app.html?action=search",
      "icons": [{ "src": "assets/icons/paperuss-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}

